<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Savage Wind Mod Manager" Manufacturer="SWMM contributors" Version="$(var.Version)" UpgradeCode="ad8c2586-529f-4dc3-aa68-673e7deb3e1c" Scope="perMachine" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Savage Wind Mod Manager is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="SwmmIcon" SourceFile="$(var.Assets)\swmm.ico" />
    <Property Id="ARPPRODUCTICON" Value="SwmmIcon" />
    <WixVariable Id="WixUILicenseRtf" Value="assets\installer\license.rtf" />
    <WixVariable Id="WixUIDialogBmp" Value="assets\installer\dialog.bmp" />
    <WixVariable Id="WixUIBannerBmp" Value="assets\installer\banner.bmp" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="SWMM">
        <Component Id="App">
          <File Id="SwmmExe" Source="$(var.Bin)\swmm.exe" KeyPath="yes" />
          <File Id="SwmmDll" Name="swmm.dll" Source="$(var.Bin)\swmm_loader.dll" />
        </Component>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="SwmmShortcut" Name="Savage Wind Mod Manager" Description="Savage Wind Mod Manager" Target="[INSTALLFOLDER]swmm.exe" WorkingDirectory="INSTALLFOLDER" Icon="SwmmIcon" />
        <RegistryValue Root="HKLM" Key="Software\SWMM" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
    <Feature Id="Main" Title="Savage Wind Mod Manager">
      <ComponentRef Id="App" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
</Wix>
